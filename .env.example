# Address reachable from the Safety Digital container.
SHE_PUBLIC_URL=https://she.sugidigital.org
# Optional Web Push contact, e.g. mailto:your-she-team@example.com.
# Defaults to SHE_PUBLIC_URL. Signing keys persist in the SHE database.
SHE_PUSH_SUBJECT=
# If CMMS runs on this Docker host, use http://host.docker.internal:3300.
CMMS_URL=http://host.docker.internal:3300
# Create a dedicated CMMS requester with Department SHE and the correct plant access.
CMMS_USERNAME=safety-digital-she
CMMS_PASSWORD=replace-with-a-long-unique-password
